<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>FamilySplit.Api</RootNamespace>
    <AssemblyName>FamilySplit.Api</AssemblyName>
    <UserSecretsId>familysplit-api-dev</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FamilySplit.Common\FamilySplit.Common.csproj" />
    <ProjectReference Include="..\FamilySplit.Infrastructure\FamilySplit.Infrastructure.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Activities\FamilySplit.Features.Activities.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Admin\FamilySplit.Features.Admin.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Auth\FamilySplit.Features.Auth.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Dashboard\FamilySplit.Features.Dashboard.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Expenses\FamilySplit.Features.Expenses.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Families\FamilySplit.Features.Families.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Groups\FamilySplit.Features.Groups.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Notifications\FamilySplit.Features.Notifications.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Settlements\FamilySplit.Features.Settlements.csproj" />
    <ProjectReference Include="..\Features\FamilySplit.Features.Users\FamilySplit.Features.Users.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="FamilySplit.Common.Security" />
  </ItemGroup>

</Project>
